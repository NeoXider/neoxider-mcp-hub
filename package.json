{
  "name": "@neoxider/mcp-hub",
  "version": "0.10.2",
  "description": "One lazy MCP tool for every server and skill you own: a human-approved capability broker for any MCP client",
  "type": "module",
  "private": false,
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "model-context-protocol",
    "lazy-loading",
    "token-optimization",
    "skills",
    "agent-skills",
    "mcp-server",
    "mcp-gateway",
    "context-window",
    "tool-search",
    "opencode",
    "claude-code",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeoXider/neoxider-mcp-hub.git"
  },
  "homepage": "https://github.com/NeoXider/neoxider-mcp-hub#readme",
  "bugs": "https://github.com/NeoXider/neoxider-mcp-hub/issues",
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "mcp-hub": "dist/src/server.js",
    "capability-hub-mcp": "dist/src/server.js",
    "capability-hub-admin": "dist/src/admin.js",
    "capability-hub-client": "dist/src/client.js",
    "capability-hub-harness-smoke": "dist/src/harness-smoke.js"
  },
  "main": "./dist/src/dsh-plugin.js",
  "exports": {
    ".": "./dist/src/dsh-plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "data/catalog.json",
    "data/skills",
    "examples",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "catalog": {
      "category": "integration",
      "summary": {
        "en": "One stable tool instead of every MCP schema you own: a lazy capability broker with measured context savings.",
        "zh": "把全部 MCP 工具收敛为一个常驻工具：按需唤醒的懒能力代理，上下文节省均有实测数据。"
      },
      "capabilities": ["mcp", "lazy-loading", "token-optimization", "skills"]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/server.js --catalog data/catalog.json --state data/state",
    "client": "node dist/src/client.js --catalog data/catalog.json --state data/state",
    "smoke:harness": "pnpm run build && node dist/src/harness-smoke.js",
    "smoke:harness:external": "pnpm run build && node dist/src/harness-smoke.js --external-playwright",
    "bench": "pnpm run build && node bench/measure.mjs",
    "proof": "pnpm run build && node bench/dynamic-proof.mjs",
    "bench:accuracy": "pnpm run build && node bench/accuracy.mjs",
    "bench:schemas": "node bench/capture-schemas.mjs",
    "bench:head-to-head": "pnpm run build && node bench/head-to-head.mjs",
    "bench:distractors": "node bench/capture-distractors.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "publishConfig": { "access": "public" },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@playwright/mcp": "0.0.79",
    "@types/node": "24.10.1",
    "gpt-tokenizer": "^4.0.0",
    "typescript": "5.9.3"
  }
}
